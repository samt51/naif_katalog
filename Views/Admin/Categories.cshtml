@model List<naif_katalog.Models.CategoryDto>
@using Microsoft.Extensions.Configuration
@inject IConfiguration Configuration
@{
    var apiAddress = Configuration["ApiAdress"] ?? "https://apib2b.naifjewellery.com/";
    if (apiAddress.EndsWith("/")) apiAddress = apiAddress.Substring(0, apiAddress.Length - 1);
    ViewData["Title"] = "Kategoriler";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    // Recursive helper for list items
    async Task RenderCategoryItem(naif_katalog.Models.CategoryDto cat, int level, List<naif_katalog.Models.CategoryDto> allCats)
    {
        var children = allCats.Where(c => c.ParentId == cat.Id).OrderBy(c => c.OrderIndex).ToList();
        
        <div class="category-item border rounded mb-2 bg-white shadow-sm" data-id="@cat.Id">
            <div class="d-flex align-items-center p-3 border-bottom-0">
                <div class="me-3 cursor-grab drag-handle text-muted" style="cursor: grab;" title="Sürükle bırak ile sırala">
                    <i class="fas fa-grip-vertical fs-5"></i>
                </div>
                <div class="flex-grow-1">
                    @if(level > 0) { <i class="fas fa-level-up-alt fa-rotate-90 text-muted me-2 opacity-50"></i> }
                    <span class="@(level == 0 ? "fw-bold text-dark fs-5" : (level == 1 ? "fw-medium text-secondary fs-6" : "text-muted"))">@cat.Name</span>
                </div>
                <div class="mx-4" style="width: 120px;">
                    @if(level == 0) { <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 px-3 py-2 rounded-pill w-100">Ana Kategori</span> }
                    else if(level == 1) { <span class="badge bg-info bg-opacity-10 text-info border border-info border-opacity-25 px-3 py-2 rounded-pill w-100">Alt Kategori</span> }
                    else { <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary border-opacity-25 px-3 py-2 rounded-pill w-100">Seviye @(level+1) Kategori</span> }
                </div>
                <div class="text-end">
                    <button type="button" onclick='openCategoryProducts(@cat.Id, @Html.Raw(System.Text.Json.JsonSerializer.Serialize(cat.Name)))' class="btn btn-sm btn-light text-success border me-1" title="Kategori Ürünlerini Göster"><i class="fas fa-box-open"></i></button>
                    <button onclick="openModal('Alt Kategori Ekle', 0, '', @cat.Id)" class="btn btn-sm btn-light text-primary border me-1" title="Buna Alt Kategori Ekle"><i class="fas fa-plus"></i></button>
                    <button onclick="openModal('Kategori Güncelle', @cat.Id, '@cat.Name', @cat.ParentId)" class="btn btn-sm btn-light text-secondary border me-1" title="Düzenle"><i class="fas fa-edit"></i></button>
                    <button class="btn btn-sm btn-light text-danger border" title="Sil" onclick="deleteCategory(@cat.Id)"><i class="fas fa-trash"></i></button>
                </div>
            </div>
            
            <div class="sub-category-list p-2 ps-5 bg-light" data-parent="@cat.Id" style="min-height: 10px; @(children.Count == 0 ? "display:none;" : "") border-top: 1px dashed #dee2e6; border-radius: 0 0 4px 4px;">
                @foreach (var child in children)
                {
                    await RenderCategoryItem(child, level + 1, allCats);
                }
            </div>
        </div>
    }

    async Task RenderCategoryOption(naif_katalog.Models.CategoryDto cat, int level, List<naif_katalog.Models.CategoryDto> allCats)
    {
        var prefix = new string('-', level * 2);
        if (level > 0) prefix = " " + prefix + "> ";
        <option value="@cat.Id">@prefix @cat.Name</option>
        var children = allCats.Where(c => c.ParentId == cat.Id).OrderBy(c => c.OrderIndex).ToList();
        foreach (var child in children)
        {
            await RenderCategoryOption(child, level + 1, allCats);
        }
    }
}

<style>
    .modal-overlay {
        position: fixed; top: 0; left: 0; width: 100%; height: 100%;
        background: rgba(0, 0, 0, 0.4);
        display: none; justify-content: center; align-items: center; z-index: 1050;
        backdrop-filter: blur(5px);
    }
    .modal-overlay.active { display: flex; animation: fadeIn 0.2s ease-out; }
    .modal-content {
        background: #fff; padding: 25px; border-radius: 16px;
        width: 100%; max-width: 450px; box-shadow: 0 20px 40px rgba(0,0,0,0.15);
        border: none;
    }
    .modal-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 25px; border-bottom: 1px solid #eee; padding-bottom: 15px; }
    .modal-header h3 { margin: 0; font-size: 20px; font-weight: 600; color: #2c3e50; }
    .btn-close { background: none; border: none; font-size: 24px; cursor: pointer; color: #95a5a6; transition: 0.2s; }
    .btn-close:hover { color: #e74c3c; }
    .form-group { margin-bottom: 20px; }
    .form-group label { display: block; margin-bottom: 8px; font-weight: 600; font-size: 13px; color: #7f8c8d; text-transform: uppercase; letter-spacing: 0.5px; }
    .form-control-custom { width: 100%; padding: 12px 15px; border: 2px solid #ecf0f1; border-radius: 8px; outline: none; font-size: 15px; transition: 0.3s; color: #2c3e50; }
    .form-control-custom:focus { border-color: #3498db; box-shadow: 0 0 0 4px rgba(52, 152, 219, 0.1); }
    
    .category-card { background: #fff; border-radius: 12px; box-shadow: 0 5px 15px rgba(0,0,0,0.05); overflow: hidden; }
    
    .sortable-ghost { opacity: 0.4; background-color: #f8f9fa; border: 2px dashed #0d6efd !important; }
    .cursor-grab:active { cursor: grabbing !important; }

    .product-browser-overlay { position: fixed; inset: 0; z-index: 1060; display: none; background: rgba(15,23,42,.62); backdrop-filter: blur(5px); padding: 24px; }
    .product-browser-overlay.active { display: flex; align-items: center; justify-content: center; }
    .product-browser { width: min(1180px, 100%); height: min(820px, 94vh); background: #f8fafc; border-radius: 20px; box-shadow: 0 28px 80px rgba(0,0,0,.28); overflow: hidden; display: flex; flex-direction: column; }
    .product-browser-head { padding: 20px 24px; background: #fff; border-bottom: 1px solid #e5e7eb; display: flex; justify-content: space-between; align-items: center; }
    .product-filter-bar { padding: 14px 24px; background: #fff; border-bottom: 1px solid #e5e7eb; display: grid; grid-template-columns: minmax(220px,2fr) repeat(3,minmax(145px,1fr)); gap: 10px; }
    .product-grid { padding: 20px 24px; overflow: auto; display: grid; grid-template-columns: repeat(4,minmax(0,1fr)); gap: 14px; align-content: start; flex: 1; }
    .category-product-card { background: #fff; border: 1px solid #e5e7eb; border-radius: 14px; overflow: hidden; transition: .2s; }
    .category-product-card:hover { transform: translateY(-2px); box-shadow: 0 12px 28px rgba(15,23,42,.10); border-color: #bfdbfe; }
    .category-product-image { height: 150px; background: #f1f5f9; display: flex; align-items: center; justify-content: center; }
    .category-product-image img { width: 100%; height: 100%; object-fit: contain; }
    .product-browser-footer { padding: 12px 24px; background: #fff; border-top: 1px solid #e5e7eb; display: flex; align-items: center; justify-content: space-between; }
    @@media(max-width: 900px) { .product-grid { grid-template-columns: repeat(2,minmax(0,1fr)); } .product-filter-bar { grid-template-columns: 1fr 1fr; } }
    @@media(max-width: 560px) { .product-browser-overlay { padding: 0; } .product-browser { height: 100vh; border-radius: 0; } .product-grid,.product-filter-bar { grid-template-columns: 1fr; } }
    
    @@keyframes fadeIn {
        from { opacity: 0; transform: translateY(-10px); }
        to { opacity: 1; transform: translateY(0); }
    }
</style>

<div class="category-card p-4">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
        <div>
            <h2 class="h4 mb-1 fw-bold text-dark"><i class="fas fa-sitemap text-primary me-2"></i> Kategori Yönetimi</h2>
            <p class="text-muted mb-0 small">Kategorilerinizi hiyerarşik olarak yönetin. Sıralamayı değiştirmek için soldaki tutamaçtan <i class="fas fa-grip-vertical mx-1"></i> sürükleyip bırakabilirsiniz.</p>
        </div>
        <button onclick="openModal('Yeni Kategori Ekle', 0, '', 0)" class="btn btn-primary rounded-pill px-4 shadow-sm">
            <i class="fas fa-plus me-1"></i> Yeni Ana Kategori
        </button>
    </div>

    <div class="category-list" id="mainCategoryList">
        @if(Model != null && Model.Count > 0)
        {
            var mainCategories = Model.Where(c => c.ParentId == 0).OrderBy(c => c.OrderIndex).ToList();
            if(mainCategories.Count == 0)
            {
                <div class="text-center py-5 text-muted">Kategori bulunamadı.</div>
            }
            foreach(var item in mainCategories)
            {
                await RenderCategoryItem(item, 0, Model);
            }
        }
        else
        {
            <div class="text-center py-5 text-muted">Kategori bulunamadı. Lütfen yeni kategori ekleyin.</div>
        }
    </div>
</div>

<div class="modal-overlay" id="categoryModal">
    <div class="modal-content">
        <div class="modal-header">
            <h3 id="modalTitle">Kategori Ekle</h3>
            <button class="btn-close" type="button" onclick="closeModal()"><i class="fas fa-times"></i></button>
        </div>
        <form id="categoryForm">
            <input type="hidden" id="categoryId" name="Id" value="0" />
            <div class="form-group">
                <label>Bağlı Olduğu Kategori (Üst Kategori)</label>
                <select id="parentCategory" name="ParentId" class="form-control-custom">
                    <option value="0" class="fw-bold">--- ANA KATEGORİ (Bağımsız) ---</option>
                    @if(Model != null)
                    {
                        foreach(var cat in Model.Where(c => c.ParentId == 0).OrderBy(c => c.OrderIndex))
                        {
                            await RenderCategoryOption(cat, 0, Model);
                        }
                    }
                </select>
            </div>
            <div class="form-group">
                <label>Kategori Adı</label>
                <input type="text" id="categoryName" name="Name" class="form-control-custom" required placeholder="Örn: Alyans..." />
            </div>
            <div class="form-group">
                <label>Çeviri</label>
                <select id="categoryLanguage" class="form-control-custom" style="margin-bottom:7px;" onchange="loadCategoryTranslation()"></select>
                <input type="text" id="categoryNameEn" class="form-control-custom" placeholder="English category name..." />
                <small id="categoryNameEnHint" class="text-muted" style="display:none;">Önce kategoriyi kaydedin, ardından düzenleyerek çevirisini ekleyin.</small>
            </div>
            <button type="submit" class="btn btn-primary w-100 py-3 rounded-pill fw-bold shadow-sm mt-2" id="btnSave">Kategoriyi Kaydet</button>
        </form>
    </div>
</div>

<div class="product-browser-overlay" id="categoryProductsModal" onclick="if(event.target===this) closeCategoryProducts()">
    <section class="product-browser" role="dialog" aria-modal="true" aria-labelledby="categoryProductsTitle">
        <header class="product-browser-head">
            <div>
                <div class="small text-primary fw-bold text-uppercase">Kategori ürünleri</div>
                <h3 class="h5 mb-0 fw-bold" id="categoryProductsTitle">Ürünler</h3>
            </div>
            <button type="button" class="btn btn-light rounded-circle" onclick="closeCategoryProducts()" aria-label="Kapat"><i class="fas fa-times"></i></button>
        </header>
        <div class="product-filter-bar">
            <div class="input-group"><span class="input-group-text bg-white"><i class="fas fa-search text-muted"></i></span><input id="categoryProductSearch" class="form-control" placeholder="Ürün kodu veya adı ara..."></div>
            <select id="categoryProductImageFilter" class="form-select"><option value="all">Tüm görseller</option><option value="with">Görseli olan</option><option value="without">Görseli olmayan</option></select>
            <select id="categoryProductPurityFilter" class="form-select"><option value="all">Tüm ayarlar</option></select>
            <select id="categoryProductSort" class="form-select"><option value="code">Koda göre</option><option value="name">Ada göre</option><option value="priceAsc">Fiyat: Artan</option><option value="priceDesc">Fiyat: Azalan</option></select>
        </div>
        <div id="categoryProductGrid" class="product-grid"></div>
        <footer class="product-browser-footer"><span id="categoryProductSummary" class="small text-muted"></span><nav id="categoryProductPagination" class="btn-group btn-group-sm"></nav></footer>
    </section>
</div>

<!-- Sortable.js -->
<script src="https://cdn.jsdelivr.net/npm/sortablejs@latest/Sortable.min.js"></script>
<script>
    const API_BASE_URL = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(apiAddress));
    async function loadCategoryLanguages() {
        const select = document.getElementById('categoryLanguage');
        const current = select.value || 'en';
        select.innerHTML = '<option value="">Diller yükleniyor...</option>';
        let languages = [];
        try {
            const response = await fetch(`${API_BASE_URL}/api/catalog-languages`, { headers: { 'Accept': 'application/json' } });
            if (!response.ok) throw new Error(`Dil servisi: ${response.status}`);
            const result = await response.json();
            languages = result.data || result.Data || [];
        } catch (error) {
            console.error('Katalog dilleri yüklenemedi:', error);
        }
        // Eski yayınlarda dil tablosu henüz oluşmamışsa modal boş kalmasın.
        if (!Array.isArray(languages) || languages.length === 0) {
            languages = [{ code: 'en', name: 'English' }, { code: 'it', name: 'Italiano' }];
        }
        select.innerHTML = '';
        languages.filter(x => String(x.code || x.Code).toLowerCase() !== 'tr').forEach(language => {
            const code = String(language.code || language.Code || '').toLowerCase();
            if (!code) return;
            const option = document.createElement('option');
            option.value = code;
            option.textContent = `${language.name || language.Name || code} (${code})`;
            select.appendChild(option);
        });
        if (select.options.length === 0) select.innerHTML = '<option value="en">English (en)</option>';
        if ([...select.options].some(x => x.value === current)) select.value = current;
    }
    async function loadCategoryTranslation() {
        const id = parseInt(document.getElementById('categoryId').value);
        const language = document.getElementById('categoryLanguage').value;
        document.getElementById('categoryNameEn').value = '';
        if (id <= 0 || !language) return;
        const response = await fetch(`${API_BASE_URL}/api/definition-translations?entityType=Category&entityId=${id}&languageCode=${encodeURIComponent(language)}`);
        const translation = await response.json();
        document.getElementById('categoryNameEn').value = translation.data || '';
    }
    document.addEventListener("DOMContentLoaded", function() {
        loadCategoryLanguages();
        // Init Sortable for main list
        var mainList = document.getElementById('mainCategoryList');
        if(mainList) {
            new Sortable(mainList, {
                handle: '.drag-handle',
                animation: 150,
                ghostClass: 'sortable-ghost',
                onEnd: function(evt) {
                    saveOrder(evt.to);
                }
            });
        }
        
        // Init Sortable for sub lists
        var subLists = document.querySelectorAll('.sub-category-list');
        subLists.forEach(function(list) {
            new Sortable(list, {
                handle: '.drag-handle',
                animation: 150,
                ghostClass: 'sortable-ghost',
                onEnd: function(evt) {
                    saveOrder(evt.to);
                }
            });
        });
    });

    function saveOrder(container) {
        let items = container.querySelectorAll(':scope > .category-item');
        let orderData = [];
        items.forEach((item, index) => {
            let id = parseInt(item.getAttribute('data-id'));
            if(id) {
                orderData.push({ id: id, orderIndex: index });
            }
        });
        
        if(orderData.length === 0) return;
        
        fetch('/Admin/UpdateCategoryOrder', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({ categories: orderData })
        })
        .then(res => res.json())
        .then(data => {
            if(!data.isSuccess) {
                Swal.fire('Hata', 'Sıralama kaydedilemedi.', 'error');
            }
        })
        .catch(err => {
            console.error('Sıralama hatası:', err);
        });
    }

    async function openModal(title, id = 0, currentName = '', parentId = 0) {
        document.getElementById('categoryId').value = id;
        document.getElementById('modalTitle').innerText = title;
        document.getElementById('categoryName').value = currentName;
        document.getElementById('categoryNameEn').value = '';
        document.getElementById('categoryNameEn').disabled = id <= 0;
        document.getElementById('categoryNameEnHint').style.display = id <= 0 ? 'block' : 'none';
        try {
            await loadCategoryLanguages();
            if (id > 0) {
                await loadCategoryTranslation();
            }
        } catch (_) { }
        
        let selectEl = document.getElementById('parentCategory');
        let optionExists = Array.from(selectEl.options).some(opt => opt.value == parentId);
        selectEl.value = optionExists ? parentId : 0;
        
        document.getElementById('categoryModal').classList.add('active');
        document.getElementById('categoryName').focus();
    }

    function closeModal() {
        document.getElementById('categoryModal').classList.remove('active');
    }

    function deleteCategory(id) {
        Swal.fire({
            title: 'Emin misiniz?',
            text: 'Bu kategoriyi silmek istediğinize emin misiniz?',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#d33',
            cancelButtonColor: '#3085d6',
            confirmButtonText: 'Evet, Sil!',
            cancelButtonText: 'İptal'
        }).then((result) => {
            if (result.isConfirmed) {
                fetch(`${API_BASE_URL}/api/Category/${id}`, {
                    method: 'DELETE'
                })
                .then(async res => {
                    const data = await res.json().catch(() => null);
                    return { ok: res.ok, data };
                })
                .then(({ ok, data }) => {
                    const isSuccess = ok && (
                        data === true ||
                        data?.isSuccess === true ||
                        data?.success === true ||
                        data?.data === true
                    );

                    if (isSuccess) {
                        Swal.fire(
                            'Silindi!',
                            'Kategori başarıyla silindi.',
                            'success'
                        ).then(() => {
                            location.reload();
                        });
                    } else {
                        const message = data?.message
                            || (Array.isArray(data?.errors) ? data.errors.join(', ') : null)
                            || 'Kategori silinirken bir hata oluştu.';
                        Swal.fire('Hata!', message, 'error');
                    }
                })
                .catch(err => {
                    console.error(err);
                    Swal.fire('Hata!', 'Sunucuya bağlanılamadı.', 'error');
                });
            }
        });
    }

    document.getElementById('categoryForm').addEventListener('submit', async (e) => {
        e.preventDefault();
        
        const id = parseInt(document.getElementById('categoryId').value);
        const name = document.getElementById('categoryName').value;
        const btn = document.getElementById('btnSave');
        
        btn.disabled = true;
        btn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i> Kaydediliyor...';

        const formData = new FormData();
        formData.append('Name', name);
        formData.append('ParentId', document.getElementById('parentCategory').value);
        
        let url = '/Category/Create'; // Wait! Does /Category/Create exist? Or is it API side via Mediator? The user's original code used /Category/Create. 
        if (id > 0) {
            url = '/Category/Update';
            formData.append('Id', id);
        }

        try {
            const res = await fetch(url, { method: 'POST', body: formData });
            const result = await res.json();
            
            if (result && result.isSuccess) {
                if (id > 0) {
                    const translationResponse = await fetch(`${API_BASE_URL}/api/definition-translations`, {
                        method: 'PUT',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ entityType: 'Category', entityId: id, languageCode: document.getElementById('categoryLanguage').value, translatedName: document.getElementById('categoryNameEn').value.trim() })
                    });
                    if (!translationResponse.ok) throw new Error('İngilizce kategori adı kaydedilemedi.');
                }
                closeModal();
                const Toast = Swal.mixin({ toast: true, position: 'top-end', showConfirmButton: false, timer: 5000, timerProgressBar: true });
                Toast.fire({ icon: 'success', title: 'Kategori başarıyla kaydedildi!' }).then(() => {
                    location.reload();
                });
            } else {
                const Toast = Swal.mixin({ toast: true, position: 'top-end', showConfirmButton: false, timer: 5000, timerProgressBar: true });
                Toast.fire({ icon: 'error', title: 'Hata!', text: result.errors ? result.errors.join(', ') : 'İşlem başarısız' });
            }
        } catch (err) {
            const Toast = Swal.mixin({ toast: true, position: 'top-end', showConfirmButton: false, timer: 5000, timerProgressBar: true });
            Toast.fire({ icon: 'error', title: 'Sistem Hatası!', text: err.message });
        } finally {
            btn.disabled = false;
            btn.innerHTML = 'Kategoriyi Kaydet';
        }
    });

    let categoryProducts = [];
    let categoryProductPage = 1;
    const categoryProductPageSize = 12;

    function escapeProductText(value) {
        return String(value ?? '').replace(/[&<>'"]/g, character => ({ '&':'&amp;', '<':'&lt;', '>':'&gt;', "'":'&#39;', '"':'&quot;' }[character]));
    }

    async function openCategoryProducts(categoryId, categoryName) {
        const modal = document.getElementById('categoryProductsModal');
        const grid = document.getElementById('categoryProductGrid');
        document.getElementById('categoryProductsTitle').textContent = categoryName;
        document.getElementById('categoryProductSearch').value = '';
        document.getElementById('categoryProductImageFilter').value = 'all';
        document.getElementById('categoryProductSort').value = 'code';
        categoryProductPage = 1;
        categoryProducts = [];
        modal.classList.add('active');
        document.body.style.overflow = 'hidden';
        grid.innerHTML = '<div class="text-center py-5 text-muted" style="grid-column:1/-1"><div class="spinner-border text-primary mb-3"></div><div>Ürünler yükleniyor...</div></div>';

        try {
            const response = await fetch(`/Category/Products?categoryId=${categoryId}`, { headers: { 'Accept': 'application/json' } });
            const result = await response.json();
            if (!response.ok || !result.isSuccess) throw new Error((result.errors || []).join(', ') || result.message || 'Ürünler alınamadı.');
            categoryProducts = result.data || [];
            fillProductPurityFilter();
            renderCategoryProducts();
        } catch (error) {
            grid.innerHTML = `<div class="alert alert-danger m-0" style="grid-column:1/-1"><i class="fas fa-exclamation-circle me-2"></i>${escapeProductText(error.message)}</div>`;
            document.getElementById('categoryProductSummary').textContent = '';
            document.getElementById('categoryProductPagination').innerHTML = '';
        }
    }

    function closeCategoryProducts() {
        document.getElementById('categoryProductsModal').classList.remove('active');
        document.body.style.overflow = '';
    }

    function fillProductPurityFilter() {
        const select = document.getElementById('categoryProductPurityFilter');
        const purities = [...new Set(categoryProducts.map(x => x.metalPurityName).filter(Boolean))].sort((a,b) => a.localeCompare(b, 'tr'));
        select.innerHTML = '<option value="all">Tüm ayarlar</option>' + purities.map(x => `<option value="${escapeProductText(x)}">${escapeProductText(x)}</option>`).join('');
    }

    function getFilteredCategoryProducts() {
        const search = document.getElementById('categoryProductSearch').value.trim().toLocaleLowerCase('tr-TR');
        const imageFilter = document.getElementById('categoryProductImageFilter').value;
        const purity = document.getElementById('categoryProductPurityFilter').value;
        const sort = document.getElementById('categoryProductSort').value;
        const hasImage = product => Boolean(product.imageName || (product.images && product.images.length));

        const filtered = categoryProducts.filter(product => {
            const matchesSearch = !search || `${product.code || ''} ${product.name || ''}`.toLocaleLowerCase('tr-TR').includes(search);
            const matchesImage = imageFilter === 'all' || (imageFilter === 'with' ? hasImage(product) : !hasImage(product));
            const matchesPurity = purity === 'all' || product.metalPurityName === purity;
            return matchesSearch && matchesImage && matchesPurity;
        });

        filtered.sort((a,b) => {
            if (sort === 'name') return (a.name || '').localeCompare(b.name || '', 'tr');
            if (sort === 'priceAsc') return (a.calculatedPrice || 0) - (b.calculatedPrice || 0);
            if (sort === 'priceDesc') return (b.calculatedPrice || 0) - (a.calculatedPrice || 0);
            return (a.code || '').localeCompare(b.code || '', 'tr', { numeric: true });
        });
        return filtered;
    }

    function renderCategoryProducts() {
        const products = getFilteredCategoryProducts();
        const totalPages = Math.max(1, Math.ceil(products.length / categoryProductPageSize));
        categoryProductPage = Math.min(categoryProductPage, totalPages);
        const start = (categoryProductPage - 1) * categoryProductPageSize;
        const visible = products.slice(start, start + categoryProductPageSize);
        const grid = document.getElementById('categoryProductGrid');

        if (!visible.length) {
            grid.innerHTML = '<div class="text-center text-muted py-5" style="grid-column:1/-1"><i class="fas fa-box-open fa-3x mb-3 opacity-25"></i><h5>Ürün bulunamadı</h5><div>Filtreleri değiştirerek tekrar deneyin.</div></div>';
        } else {
            grid.innerHTML = visible.map(product => {
                const image = product.imageName || (product.images || [])[0];
                const imageHtml = image
                    ? `<img src="${escapeProductText(image)}" alt="${escapeProductText(product.code)}" loading="lazy">`
                    : '<div class="text-muted text-center"><i class="far fa-image fa-2x mb-2"></i><div class="small">Görsel yok</div></div>';
                const price = Number(product.calculatedPrice || 0).toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                return `<article class="category-product-card"><div class="category-product-image">${imageHtml}</div><div class="p-3"><div class="fw-bold text-dark text-truncate" title="${escapeProductText(product.code)}">${escapeProductText(product.code || '-')}</div><div class="small text-muted text-truncate mb-2" title="${escapeProductText(product.name)}">${escapeProductText(product.name || 'İsimsiz ürün')}</div><div class="d-flex justify-content-between small"><span><i class="fas fa-weight-hanging text-muted me-1"></i>${Number(product.gram || 0).toLocaleString('tr-TR')} g</span><span class="fw-bold text-primary">$${price}</span></div><div class="mt-2 d-flex gap-1"><span class="badge bg-light text-secondary border">${escapeProductText(product.metalPurityName || '-')}</span><span class="badge bg-light text-secondary border">${Number(product.diamondCarat || 0).toLocaleString('tr-TR')} ct</span></div></div></article>`;
            }).join('');
        }

        document.getElementById('categoryProductSummary').textContent = `${products.length} ürün bulundu${products.length ? ` • ${start + 1}-${Math.min(start + categoryProductPageSize, products.length)} gösteriliyor` : ''}`;
        renderCategoryProductPagination(totalPages);
    }

    function renderCategoryProductPagination(totalPages) {
        const nav = document.getElementById('categoryProductPagination');
        if (totalPages <= 1) { nav.innerHTML = ''; return; }
        const buttons = [];
        buttons.push(`<button class="btn btn-outline-primary" ${categoryProductPage === 1 ? 'disabled' : ''} onclick="changeCategoryProductPage(${categoryProductPage - 1})"><i class="fas fa-chevron-left"></i></button>`);
        for (let page = 1; page <= totalPages; page++) {
            if (page === 1 || page === totalPages || Math.abs(page - categoryProductPage) <= 1) buttons.push(`<button class="btn ${page === categoryProductPage ? 'btn-primary' : 'btn-outline-primary'}" onclick="changeCategoryProductPage(${page})">${page}</button>`);
            else if (buttons[buttons.length - 1] !== '<span class="btn btn-light disabled">…</span>') buttons.push('<span class="btn btn-light disabled">…</span>');
        }
        buttons.push(`<button class="btn btn-outline-primary" ${categoryProductPage === totalPages ? 'disabled' : ''} onclick="changeCategoryProductPage(${categoryProductPage + 1})"><i class="fas fa-chevron-right"></i></button>`);
        nav.innerHTML = buttons.join('');
    }

    function changeCategoryProductPage(page) { categoryProductPage = page; renderCategoryProducts(); document.getElementById('categoryProductGrid').scrollTop = 0; }
    ['categoryProductImageFilter','categoryProductPurityFilter','categoryProductSort'].forEach(id => document.getElementById(id).addEventListener('change', () => { categoryProductPage = 1; renderCategoryProducts(); }));
    document.getElementById('categoryProductSearch').addEventListener('input', () => { categoryProductPage = 1; renderCategoryProducts(); });
    document.addEventListener('keydown', event => { if (event.key === 'Escape' && document.getElementById('categoryProductsModal').classList.contains('active')) closeCategoryProducts(); });
</script>
