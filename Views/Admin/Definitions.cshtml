@model dynamic
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    ViewData["Title"] = "Genel Tanımlamalar";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var apiAddress = Configuration["ApiAdress"] ?? "https://apib2b.naifjewellery.com/";
    if (apiAddress.EndsWith("/")) apiAddress = apiAddress.Substring(0, apiAddress.Length - 1);
}

<style>
    .def-page { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px; }
    .def-card { margin-bottom: 0; }
    .def-card-title {
        display: flex; align-items: center; gap: 10px;
        margin: 0 0 16px; padding-bottom: 12px;
        border-bottom: 1px solid var(--border-color);
        font-size: 16px;
    }
    .def-card-title i {
        width: 34px; height: 34px; border-radius: 10px;
        display: inline-flex; align-items: center; justify-content: center;
        background: #eff6ff; color: var(--primary);
    }
    .def-section { margin-bottom: 16px; }
    .def-section:last-child { margin-bottom: 0; }
    .def-section-head {
        display: flex; justify-content: space-between; align-items: center;
        gap: 8px; margin-bottom: 10px;
    }
    .def-section-head h4 { margin: 0; font-size: 13px; font-weight: 600; color: var(--text-muted); }
    .def-add {
        width: 32px; height: 32px; border: 0; border-radius: 8px;
        background: #eff6ff; color: var(--primary); cursor: pointer;
        display: inline-flex; align-items: center; justify-content: center;
    }
    .def-tags { display: flex; flex-wrap: wrap; gap: 8px; }
    .def-item {
        background: #f8fafc; padding: 8px 12px; border-radius: 999px; font-size: 13px;
        border: 1px solid #e2e8f0; cursor: pointer; user-select: none;
        display: inline-flex; align-items: center; min-height: 36px; line-height: 1.2;
        max-width: 100%; word-break: break-word;
    }
    .def-item:hover { background: #e2e8f0; }
    .def-item-amber { background: #fef3c7; color: #92400e; border-color: #fde68a; }
    .def-item-pink { background: #fce7f3; color: #9d174d; border-color: #fbcfe8; }
    .def-item-indigo { background: #e0e7ff; color: #3730a3; border-color: #c7d2fe; }
    .def-item-green { background: #dcfce7; color: #166534; border-color: #bbf7d0; }
    .def-hint { display: block; color: var(--text-muted); margin-top: 8px; line-height: 1.4; font-size: 12px; }

    .modal-overlay {
        position: fixed; top: 0; left: 0; width: 100%; height: 100%;
        background: rgba(0, 0, 0, 0.5);
        display: none; justify-content: center; align-items: center; z-index: 1000;
        backdrop-filter: blur(4px);
    }
    .modal-overlay.active { display: flex; }
    .modal-content {
        background: var(--card-bg); padding: 24px; border-radius: 12px;
        width: 100%; max-width: 400px; box-shadow: 0 10px 25px rgba(0,0,0,0.1);
        max-height: 90vh; overflow-y: auto;
    }
    .modal-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; }
    .modal-header h3 { margin: 0; font-size: 18px; }
    .btn-close { background: none; border: none; font-size: 20px; cursor: pointer; color: var(--text-muted); }
    .form-group { margin-bottom: 15px; }
    .form-group label { display: block; margin-bottom: 8px; font-weight: 500; font-size: 14px; }
    .form-group input { width: 100%; padding: 10px 12px; border: 1px solid var(--border-color); border-radius: 6px; outline: none; }
    .form-group input:focus { border-color: var(--primary); }

    @@media (max-width: 1024px) {
        .def-page { grid-template-columns: 1fr; gap: 12px; }
    }
    @@media (max-width: 767.98px) {
        .def-card { padding: 14px; }
        .def-card-title { font-size: 15px; }
        .def-item { min-height: 40px; padding: 9px 12px; }
        .modal-overlay { padding: 10px; align-items: flex-start; overflow-y: auto; }
        .modal-content { max-width: 100%; margin-top: 24px; }
    }
</style>

<div class="def-page">
    <div class="card def-card">
        <h3 class="def-card-title"><i class="fas fa-gem"></i> Taş & Kesim Tanımları</h3>
        <div class="def-section">
            <div class="def-section-head">
                <h4>Taş Tipleri</h4>
                <button type="button" class="def-add" onclick="openModal('StoneType', 'Taş Tipi Ekle')" aria-label="Taş tipi ekle"><i class="fas fa-plus"></i></button>
            </div>
            <div class="def-tags">
                @if(Model.StoneTypes != null) {
                    foreach(var item in Model.StoneTypes) {
                        <span class="def-item" onclick="openModal('StoneType', 'Taş Tipi Güncelle', @item.Id, '@item.Name')">@item.Name</span>
                    }
                }
            </div>
        </div>
        <div class="def-section">
            <div class="def-section-head">
                <h4>Taş Ayarları (Boyut)</h4>
                <button type="button" class="def-add" onclick="openModal('StoneScale', 'Taş Ayarı Ekle')" aria-label="Taş ayarı ekle"><i class="fas fa-plus"></i></button>
            </div>
            <div class="def-tags">
                @if(Model.StoneScales != null) {
                    foreach(var item in Model.StoneScales) {
                        <span class="def-item" onclick="openModal('StoneScale', 'Taş Ayarı Güncelle', @item.Id, '@item.Name')">@item.Name</span>
                    }
                }
            </div>
        </div>
        <div class="def-section">
            <div class="def-section-head">
                <h4>Taş Kesimleri</h4>
                <button type="button" class="def-add" onclick="openModal('StoneCut', 'Taş Kesimi Ekle')" aria-label="Taş kesimi ekle"><i class="fas fa-plus"></i></button>
            </div>
            <div class="def-tags">
                @if(Model.StoneCuts != null) {
                    foreach(var item in Model.StoneCuts) {
                        <span class="def-item" onclick="openModal('StoneCut', 'Taş Kesimi Güncelle', @item.Id, '@item.Name')">@item.Name</span>
                    }
                }
            </div>
        </div>
        <div class="def-section">
            <div class="def-section-head">
                <h4>Taş Berraklığı</h4>
                <button type="button" class="def-add" onclick="openModal('StoneClarity', 'Taş Berraklığı Ekle')" aria-label="Taş berraklığı ekle"><i class="fas fa-plus"></i></button>
            </div>
            <div class="def-tags">
                @if(Model.StoneClarities != null) {
                    foreach(var item in Model.StoneClarities) {
                        <span class="def-item" onclick="openModal('StoneClarity', 'Taş Berraklığı Güncelle', @item.Id, '@item.Name')">@item.Name</span>
                    }
                }
            </div>
        </div>
        <div class="def-section">
            <div class="def-section-head">
                <h4>Renkler (Taş Rengi)</h4>
                <button type="button" class="def-add" onclick="openModal('Color', 'Renk Ekle')" aria-label="Renk ekle"><i class="fas fa-plus"></i></button>
            </div>
            <div class="def-tags">
                @if(Model.Colors != null) {
                    foreach(var item in Model.Colors) {
                        if(item.ColorType == "Stone") {
                            <span class="def-item" onclick="openModal('Color', 'Renk Güncelle', @item.Id, '@item.Name')">@item.Name</span>
                        }
                    }
                }
            </div>
        </div>
    </div>

    <div class="card def-card">
        <h3 class="def-card-title"><i class="fas fa-ring"></i> Maden Tanımları</h3>
        <div class="def-section">
            <div class="def-section-head">
                <h4>Maden Tipleri</h4>
                <button type="button" class="def-add" onclick="openModal('MetalType', 'Maden Tipi Ekle')" aria-label="Maden tipi ekle"><i class="fas fa-plus"></i></button>
            </div>
            <div class="def-tags">
                @if(Model.MetalTypes != null) {
                    foreach(var item in Model.MetalTypes) {
                        <span class="def-item def-item-amber" onclick="openModal('MetalType', 'Maden Tipi Güncelle', @item.Id, '@item.Name')">@item.Name</span>
                    }
                }
            </div>
        </div>
        <div class="def-section">
            <div class="def-section-head">
                <h4>Maden Ayarları</h4>
                <button type="button" class="def-add" onclick="openModal('MetalPurity', 'Maden Ayarı Ekle')" aria-label="Maden ayarı ekle"><i class="fas fa-plus"></i></button>
            </div>
            <div class="def-tags">
                @if(Model.MetalPurities != null) {
                    foreach(var item in Model.MetalPurities) {
                        <span class="def-item" onclick="openModal('MetalPurity', 'Maden Ayarı Güncelle', @item.Id, '@item.Name')">@item.Name</span>
                    }
                }
            </div>
        </div>
    </div>

    <div class="card def-card">
        <h3 class="def-card-title"><i class="fas fa-paint-brush"></i> Cila/Rodaj Maliyetleri</h3>
        <div class="def-section">
            <div class="def-section-head">
                <h4>Kategoriye Göre Maliyetler</h4>
                <button type="button" class="def-add" onclick="openPolishingModal()" aria-label="Cila maliyeti ekle"><i class="fas fa-plus"></i></button>
            </div>
            <div class="def-tags">
                @if(Model.PolishingCosts != null) {
                    foreach(var item in Model.PolishingCosts) {
                        <span class="def-item def-item-pink" onclick="openPolishingModal(@item.Id, @item.CategoryId, @item.CostPrice.ToString(System.Globalization.CultureInfo.InvariantCulture))">@item.CategoryName (Ü: $@item.CostPrice.ToString("N2", new System.Globalization.CultureInfo("tr-TR")))</span>
                    }
                }
            </div>
        </div>
        <div class="def-section">
            <div class="def-section-head">
                <h4>Mıhlama Tipleri ve Fiyatları</h4>
                <button type="button" class="def-add" onclick="openStoneSettingModal()" aria-label="Mıhlama tipi ekle"><i class="fas fa-plus"></i></button>
            </div>
            <div class="def-tags">
                @if(Model.StoneSettings != null) {
                    foreach(var item in Model.StoneSettings) {
                        <span class="def-item def-item-indigo" onclick="openStoneSettingModal(@item.Id, @item.UnitId, @item.SettingPrice.ToString(System.Globalization.CultureInfo.InvariantCulture))">@item.SettingType ($@item.SettingPrice.ToString("N2", new System.Globalization.CultureInfo("tr-TR")))</span>
                    }
                }
            </div>
        </div>
    </div>

    <div class="card def-card">
        <h3 class="def-card-title"><i class="fas fa-users-cog"></i> Sistem Tanımları</h3>
        <div class="def-section">
            <div class="def-section-head">
                <h4>Birimler</h4>
                <button type="button" class="def-add" onclick="openModal('Unit', 'Birim Ekle')" aria-label="Birim ekle"><i class="fas fa-plus"></i></button>
            </div>
            <div class="def-tags">
                @if(Model.Units != null) {
                    foreach(var item in Model.Units) {
                        <span class="def-item def-item-green" onclick="openModal('Unit', 'Birim Güncelle', @item.Id, '@item.Name')">@item.Name</span>
                    }
                }
            </div>
        </div>
        <div class="def-section">
            <div class="def-section-head">
                <h4>Katalog Dilleri</h4>
                <button type="button" class="def-add" onclick="openLanguageModal()" title="Yeni dil ekle" aria-label="Dil ekle"><i class="fas fa-plus"></i></button>
            </div>
            <div id="catalogLanguageList" class="def-tags">
                <span style="color:var(--text-muted);font-size:13px;">Diller yükleniyor...</span>
            </div>
            <small class="def-hint">Buraya eklenen diller tanım çevirilerinde ve tüm katalog PDF/Excel çıktılarında kullanılır.</small>
        </div>
    </div>
</div>

<div class="modal-overlay" id="languageModal">
    <div class="modal-content">
        <div class="modal-header">
            <h3>Yeni Katalog Dili</h3>
            <button type="button" class="btn-close" onclick="closeLanguageModal()"><i class="fas fa-times"></i></button>
        </div>
        <form id="languageForm">
            <div class="form-group">
                <label>Dil Kodu</label>
                <input type="text" id="languageCode" maxlength="10" required placeholder="Örn: en, de, it" style="text-transform:lowercase;" />
            </div>
            <div class="form-group">
                <label>Dil Adı</label>
                <input type="text" id="languageName" maxlength="100" required placeholder="Örn: English, Deutsch, Italiano" />
            </div>
            <button type="submit" class="btn-primary" id="btnSaveLanguage" style="width:100%;">Dili Kaydet</button>
        </form>
    </div>
</div>

<!-- Stone Setting Modal -->
<div class="modal-overlay" id="stoneSettingModal">
    <div class="modal-content">
        <div class="modal-header">
            <h3 id="stoneSettingModalTitle">Mıhlama Tipi Ekle</h3>
            <button class="btn-close" onclick="closeStoneSettingModal()"><i class="fas fa-times"></i></button>
        </div>
        <form id="stoneSettingForm">
            <input type="hidden" id="settingId" value="0" />
            <div class="form-group">
                <label>Birim / Mıhlama Tipi</label>
                <select id="settingType" required style="width:100%; padding:10px; border-radius:6px; border:1px solid var(--border-color);">
                    <option value="">Seçiniz</option>
                    @if(Model.Units != null) {
                        foreach(var item in Model.Units) {
                            <option value="@item.Id">@item.Name</option>
                        }
                    }
                </select>
            </div>
            <div class="form-group">
                <label>Mıhlama Fiyatı ($)</label>
                <input type="number" step="0.01" id="settingPrice" required placeholder="0.00" style="width:100%; padding:10px; border-radius:6px; border:1px solid var(--border-color);"/>
            </div>
            <div style="display:flex; gap:10px; margin-top:15px;">
                <button type="button" class="btn-danger" id="btnDelStoneSetting" style="display:none; width:100%;" onclick="deleteStoneSetting()">Sil</button>
                <button type="submit" class="btn-primary" id="btnSaveStoneSetting" style="width:100%;">Kaydet</button>
            </div>
        </form>
    </div>
</div>

<!-- Polishing Cost Modal -->
<div class="modal-overlay" id="polishingModal">
    <div class="modal-content">
        <div class="modal-header">
            <h3 id="polishingModalTitle">Cila/Rodaj Ekle</h3>
            <button class="btn-close" onclick="closePolishingModal()"><i class="fas fa-times"></i></button>
        </div>
        <form id="polishingForm">
            <input type="hidden" id="polId" value="0" />
            <div class="form-group">
                <label>Kategori</label>
                <select id="polCategoryId" required style="width:100%; padding:10px; border-radius:6px; border:1px solid var(--border-color);">
                    <option value="">Seçiniz</option>
                    @if(Model.Categories != null) {
                        foreach(var cat in Model.Categories) {
                            <option value="@cat.Id">@cat.Name</option>
                        }
                    }
                </select>
            </div>
            <div class="form-group">
                <label>Ürün Maliyeti ($)</label>
                <input type="number" step="0.01" id="polCostPrice" required placeholder="0.00" />
            </div>
            
            <div style="display:flex; gap:10px;">
                <button type="button" class="btn-danger" id="btnDelPolishing" style="display:none; width:100%;" onclick="deletePolishing()">Sil</button>
                <button type="submit" class="btn-primary" id="btnSavePolishing" style="width:100%;">Kaydet</button>
            </div>
        </form>
    </div>
</div>

<!-- Dynamic Modal -->
<div class="modal-overlay" id="defModal">
    <div class="modal-content">
        <div class="modal-header">
            <h3 id="modalTitle">Tanım Ekle</h3>
            <button class="btn-close" onclick="closeModal()"><i class="fas fa-times"></i></button>
        </div>
        <form id="defForm">
            <input type="hidden" id="defType" name="type" />
            <input type="hidden" id="defId" name="id" value="0" />
            <div class="form-group">
                <label>Tanım Adı</label>
                <input type="text" id="defName" name="name" required placeholder="Değer giriniz..." oninput="this.value = this.value.toUpperCase()" style="text-transform: uppercase;" />
            </div>
            <div class="form-group" id="englishNameGroup">
                <label>Çeviri</label>
                <div style="display:flex;gap:6px;margin-bottom:7px;">
                    <select id="defLanguage" style="flex:1;padding:9px;border:1px solid var(--border-color);border-radius:6px;" onchange="loadDefinitionTranslation()"></select>
                </div>
                <input type="text" id="defNameEn" placeholder="Seçilen dilde karşılığı..." />
                <small id="englishNameHint" style="color:var(--text-muted); display:none; margin-top:5px;">Önce tanımı kaydedin, ardından düzenleyerek çevirisini ekleyin.</small>
            </div>
            <div class="form-group" id="discountGroup" style="display:none;">
                <label>İndirim / Yüzdelik Dilim (%)</label>
                <input type="number" step="0.01" id="defDiscountRate" name="discountRate" value="0" placeholder="0.00" />
            </div>
            <div style="display:flex; gap:10px;"><button type="button" class="btn-danger" id="btnDel" style="display:none; width:100%;" onclick="deleteDefinition()">Sil</button><button type="submit" class="btn-primary" id="btnSave" style="width:100%;">Kaydet</button></div>
        </form>
    </div>
</div>


<!-- Info Modal -->
<div class="modal-overlay" id="infoModal" style="z-index: 2000;">
    <div class="modal-content" style="max-width: 320px; text-align: center; padding: 30px 20px;">
        <div style="margin-bottom: 15px;">
            <i class="fas fa-info-circle" style="font-size: 48px; color: var(--primary);"></i>
        </div>
        <h3 id="infoModalTitle" style="margin-bottom: 10px; font-size: 18px;">Bilgi</h3>
        <p id="infoModalMessage" style="color: var(--text-muted); font-size: 14px; margin-bottom: 20px;"></p>
        <button class="btn-primary" onclick="closeInfoModal()" style="width: 100%;">Tamam</button>
    </div>
</div>

<script>
    const API_BASE_URL = '@apiAddress';

    function showInfoModal(title, message) {
        document.getElementById('infoModalTitle').innerText = title;
        document.getElementById('infoModalMessage').innerText = message;
        document.getElementById('infoModal').classList.add('active');
    }

    function closeInfoModal() {
        document.getElementById('infoModal').classList.remove('active');
    }

    async function loadAvailableLanguages() {
        const select = document.getElementById('defLanguage');
        const current = select.value || 'en';
        const response = await fetch(`${API_BASE_URL}/api/catalog-languages`);
        const result = await response.json();
        select.innerHTML = '';
        (result.data || []).filter(x => x.code !== 'tr').forEach(language => {
            const option = document.createElement('option');
            option.value = language.code;
            option.textContent = `${language.name} (${language.code})`;
            select.appendChild(option);
        });
        if ([...select.options].some(x => x.value === current)) select.value = current;
    }

    async function loadDefinitionTranslation() {
        const type = document.getElementById('defType').value;
        const id = parseInt(document.getElementById('defId').value);
        const languageCode = document.getElementById('defLanguage').value;
        document.getElementById('defNameEn').value = '';
        if (!type || id <= 0 || !languageCode) return;
        const response = await fetch(`${API_BASE_URL}/api/definition-translations?entityType=${encodeURIComponent(type)}&entityId=${id}&languageCode=${encodeURIComponent(languageCode)}`);
        const result = await response.json();
        document.getElementById('defNameEn').value = result.data || '';
    }

    async function loadCatalogLanguageList() {
        const container = document.getElementById('catalogLanguageList');
        try {
            const response = await fetch(`${API_BASE_URL}/api/catalog-languages`);
            const result = await response.json();
            const languages = result.data || [];
            container.innerHTML = languages.length
                ? languages.map(language => `<span class="def-item">${escapeLanguageHtml(language.name)} <strong>(${escapeLanguageHtml(language.code)})</strong></span>`).join('')
                : '<span style="color:var(--text-muted);font-size:13px;">Henüz dil tanımlanmamış.</span>';
        } catch (_) {
            container.innerHTML = '<span style="color:#dc2626;font-size:13px;">Dil listesi alınamadı.</span>';
        }
    }

    function escapeLanguageHtml(value) {
        return String(value || '').replace(/[&<>"']/g, ch => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'})[ch]);
    }

    function openLanguageModal() {
        document.getElementById('languageForm').reset();
        document.getElementById('languageModal').classList.add('active');
        document.getElementById('languageCode').focus();
    }

    function closeLanguageModal() {
        document.getElementById('languageModal').classList.remove('active');
    }

    document.getElementById('languageForm').addEventListener('submit', async function(event) {
        event.preventDefault();
        const code = document.getElementById('languageCode').value.trim().toLowerCase();
        const name = document.getElementById('languageName').value.trim();
        if (!/^[a-z]{2,3}(-[a-z]{2,4})?$/.test(code)) {
            showInfoModal('Hata', 'Dil kodunu en, de veya pt-br biçiminde girin.');
            return;
        }
        const button = document.getElementById('btnSaveLanguage');
        button.disabled = true;
        try {
            const response = await fetch(`${API_BASE_URL}/api/catalog-languages`, {
                method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ code, name })
            });
            if (!response.ok) { showInfoModal('Hata', 'Dil eklenemedi veya dil kodu zaten mevcut.'); return; }
            closeLanguageModal();
            await Promise.all([loadCatalogLanguageList(), loadAvailableLanguages()]);
            document.getElementById('defLanguage').value = code;
            showInfoModal('Başarılı', 'Dil merkezi katalog dil listesine eklendi.');
        } finally {
            button.disabled = false;
        }
    });

    document.addEventListener('DOMContentLoaded', loadCatalogLanguageList);

    async function openModal(type, title, id = 0, currentName = '', currentDiscount = 0) {
        document.getElementById('defType').value = type;
        document.getElementById('defId').value = id;
        document.getElementById('btnDel').style.display = id > 0 ? "block" : "none";
        document.getElementById('modalTitle').innerText = title;
        document.getElementById('defName').value = currentName;
        const translatable = ['StoneType','StoneScale','StoneCut','StoneClarity','Color','MetalType','MetalPurity'].includes(type);
        document.getElementById('englishNameGroup').style.display = translatable ? 'block' : 'none';
        document.getElementById('defNameEn').value = '';
        document.getElementById('defNameEn').disabled = id <= 0;
        document.getElementById('englishNameHint').style.display = translatable && id <= 0 ? 'block' : 'none';
        if (translatable && id > 0) {
            try {
                await loadAvailableLanguages();
                await loadDefinitionTranslation();
            } catch (_) { }
        }
        
        if(type === 'CustomerGroup') {
            document.getElementById('discountGroup').style.display = 'block';
            document.getElementById('defDiscountRate').value = currentDiscount;
        } else {
            document.getElementById('discountGroup').style.display = 'none';
        }

        document.getElementById('defModal').classList.add('active');
        document.getElementById('defName').focus();
    }

    function closeModal() {
        document.getElementById('defModal').classList.remove('active');
    }

            function deleteDefinition() {
        Swal.fire({
            title: 'Emin misiniz?',
            text: "Bu tanımı silmek istediğinize emin misiniz?",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#ef4444',
            cancelButtonColor: '#6b7280',
            confirmButtonText: 'Evet, Sil',
            cancelButtonText: 'İptal'
        }).then(async (result) => {
            if (result.isConfirmed) {
                const id = document.getElementById('defId').value;
                const type = document.getElementById('defType').value;
                try {
                    const res = await fetch(`${API_BASE_URL}/api/${type}/${id}`, { method: 'DELETE' });
                    if (res.ok) location.reload();
                    else Swal.fire('Hata!', 'Silme işlemi başarısız oldu.', 'error');
                } catch(e) {
                    Swal.fire('Hata!', 'Sistem hatası.', 'error');
                }
            }
        });
    }

    document.getElementById('defForm').addEventListener('submit', async (e) => {
        e.preventDefault();
        
        const type = document.getElementById('defType').value;
        const id = parseInt(document.getElementById('defId').value);
        const name = document.getElementById('defName').value.trim().toUpperCase();
        
        // Aynı isimde kayıt olup olmadığını kontrol et
        const existingItems = Array.from(document.querySelectorAll('.def-item'))
            .filter(span => span.getAttribute('onclick') && span.getAttribute('onclick').includes(`openModal('${type}'`))
            .map(span => span.innerText.trim().toUpperCase());
            
        if (id === 0 && existingItems.includes(name)) {
            Swal.fire('Uyarı!', 'Bu tanım zaten mevcut. Lütfen farklı bir değer giriniz.', 'warning');
            return;
        }
        
        const btn = document.getElementById('btnSave');
        
        btn.disabled = true;
        btn.innerText = "Kaydediliyor...";

        const formData = new FormData();
        formData.append('type', type);
        formData.append('name', name);
        
        if (type === 'CustomerGroup') {
            const dr = document.getElementById('defDiscountRate').value;
            formData.append('discountRate', dr ? dr : 0);
        }
        
        let url = '/Definition/Create';
        if (id > 0) {
            url = '/Definition/Update';
            formData.append('id', id);
        }

        try {
            const res = await fetch(url, {
                method: 'POST',
                body: formData
            });
            
            const result = await res.json();
            
            if (result && result.isSuccess) {
                if (id > 0 && document.getElementById('englishNameGroup').style.display !== 'none') {
                    const translationResponse = await fetch(`${API_BASE_URL}/api/definition-translations`, {
                        method: 'PUT',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            entityType: type,
                            entityId: id,
                            languageCode: document.getElementById('defLanguage').value,
                            translatedName: document.getElementById('defNameEn').value.trim()
                        })
                    });
                    if (!translationResponse.ok) throw new Error('Çeviri kaydedilemedi.');
                }
                const Toast = Swal.mixin({ toast: true, position: 'top-end', showConfirmButton: false, timer: 3000, timerProgressBar: true });
                Toast.fire({ icon: 'success', title: 'İşlem Başarılı' }).then(() => { location.reload(); });
            } else {
                showInfoModal('İşlem Başarısız', result.errors ? result.errors.join(', ') : 'İşlem başarısız');
            }
        } catch (err) {
            showInfoModal('Sistem Hatası', err.message);
        } finally {
            btn.disabled = false;
            btn.innerText = "Kaydet";
        }
    });

