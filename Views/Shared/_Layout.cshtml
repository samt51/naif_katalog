@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@inject naif_katalog.Services.Abstract.ICustomerPricingService CustomerPricing
<!DOCTYPE html>
<html lang="tr">
<head>
    <script>window.NAIF_API_BASE_URL = @Html.Raw(System.Text.Json.JsonSerializer.Serialize((Configuration["ApiAdress"] ?? "https://apib2b.naifjewellery.com/").TrimEnd('/')));</script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Naif Jewellery</title>
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" />
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/naif_katalog.styles.css" asp-append-version="true" />
    @if (ViewData["IsHomePage"] is true)
    {
        <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
    }
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
</head>
<body class="customer-site @(ViewData["IsHomePage"] is true ? "home-page" : "")">
    <div id="app-version" data-version="v.1.0.0" hidden>v.1.0.0</div>
    <header class="customer-header sticky-top bg-white">
        <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom">
            <div class="container-fluid customer-nav-inner">
                @if (string.Equals(ViewContext.RouteData.Values["controller"]?.ToString(), "Home", StringComparison.OrdinalIgnoreCase))
                {
                    <button class="btn btn-link text-dark d-lg-none p-0 customer-nav-menu" id="mobileFilterHamburger" type="button" onclick="if(typeof toggleFilterSidebar === 'function') toggleFilterSidebar(); else window.location.href='/Home/Index';" title="Filtreler" aria-label="Filtreler">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="3" y1="12" x2="21" y2="12"></line>
                            <line x1="3" y1="6" x2="21" y2="6"></line>
                            <line x1="3" y1="18" x2="21" y2="18"></line>
                        </svg>
                    </button>
                }

                @if (ViewData["IsHomePage"] is true)
                {
                    <div class="home-navigation" aria-label="Ana sayfa bağlantıları">
                        <a href="/Home/Index">Tüm ürünler</a>
                        <a href="#new-arrivals">Yeni eklenenler</a>
                        <a href="#categories">Kategoriler</a>
                    </div>
                }

                <a class="navbar-brand customer-nav-logo" asp-area="" asp-controller="Home" asp-action="Welcome">
                    <img src="https://static.wixstatic.com/media/3afb87_01283146a20c43eda2fa6ba343107de9~mv2.png/v1/fill/w_299,h_95,al_c,q_85,usm_0.66_1.00_0.01,enc_avif,quality_auto/1730592442899-7c4af1dc-40ee-4adf-80ba-dd9cd7379dee_1-Photoroom.png" alt="Naif Jewellery" height="40" />
                </a>

                <div class="customer-nav-tools">
                <form class="search-form customer-search-form" action="@Url.Action("Index", "Home")" method="get" id="searchForm">
                    <div class="search-wrapper">
                        <input type="text" name="search" id="searchInput" class="search-input" placeholder="Ürün ara..." autocomplete="off"
                               value="@(ViewBag.SearchQuery ?? "")" />
                        <button type="button" class="search-clear-btn" id="searchClearBtn" title="Temizle">&times;</button>
                        <button type="submit" class="btn-search-submit" id="searchSubmitBtn" title="Ara">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="11" cy="11" r="8"></circle>
                                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                            </svg>
                        </button>
                    </div>
                </form>

                <div class="customer-nav-actions">
                    <div class="dropdown">
                        <a href="#" class="customer-icon-btn text-dark text-decoration-none dropdown-toggle fw-medium d-flex align-items-center" data-bs-toggle="dropdown" aria-label="Dil seç">
                            <img id="currentLangFlag" src="https://flagcdn.com/w20/us.png" alt="EN" width="20" class="me-1" style="border-radius:2px;">
                            <span id="currentLangText" class="d-none d-lg-inline notranslate" translate="no">EN</span>
                        </a>
                        <script>
                            (function () {
                                var lang = 'en';
                                try { lang = localStorage.getItem('naif_language') || 'en'; } catch (e) {}
                                if (lang !== 'tr') return;
                                var flag = document.getElementById('currentLangFlag');
                                var text = document.getElementById('currentLangText');
                                if (!flag || !text) return;
                                flag.src = 'https://flagcdn.com/w20/tr.png';
                                flag.alt = 'TR';
                                text.textContent = 'TR';
                            })();
                        </script>
                        <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 mt-2" style="min-width: 120px; z-index: 1050;">
                            <li><button type="button" class="dropdown-item d-flex align-items-center" onclick="changeLanguage('tr')"><img src="https://flagcdn.com/w20/tr.png" alt="TR" width="20" class="me-2" style="border-radius:2px;"> Türkçe</button></li>
                            <li><button type="button" class="dropdown-item d-flex align-items-center" onclick="changeLanguage('en')"><img src="https://flagcdn.com/w20/us.png" alt="EN" width="20" class="me-2" style="border-radius:2px;"> English</button></li>
                        </ul>
                    </div>

                    @{
                        var customerPricing = User.Identity?.IsAuthenticated == true
                            ? await CustomerPricing.GetAsync()
                            : new naif_katalog.Services.Abstract.CustomerPricing();
                    }
                    <button type="button" class="customer-b2c-button notranslate" translate="no" id="b2cButton" aria-label="B2C" data-sales-multiplier="@customerPricing.SalesMultiplier.ToString(System.Globalization.CultureInfo.InvariantCulture)" data-multiplier="@customerPricing.B2CMultiplier.ToString(System.Globalization.CultureInfo.InvariantCulture)">
                        <span class="customer-b2c-icon"><i class="fas fa-store"></i></span>
                        <span class="d-none d-lg-inline" id="pricingModeButtonText">B2C</span>
                    </button>

                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <a href="/Orders/Mine" class="btn btn-outline-dark btn-catalog-main customer-orders-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Mine" || ViewContext.RouteData.Values["action"]?.ToString() == "MineDetail" ? "active" : "")">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2L3 5v15a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V5l-3-3z"></path><path d="M3 5h18"></path><path d="M8 10h8"></path><path d="M8 14h5"></path></svg>
                            <span class="d-none d-lg-inline">Siparişlerim</span>
                        </a>
                    }

                    <button class="btn btn-outline-primary btn-catalog-main" id="myCatalogBtn" type="button" data-bs-toggle="offcanvas" data-bs-target="#catalogOffcanvas">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M6 2L3 5v15a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V5l-3-3z"></path>
                            <line x1="3" y1="5" x2="21" y2="5"></line>
                            <path d="M16 9a4 4 0 0 1-8 0"></path>
                        </svg>
                        <span id="catalogButtonText" class="d-none d-lg-inline notranslate" translate="no">My Cart</span>
                        <span>(<span id="catalogCount">0</span>)</span>
                    </button>

                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        @if(User.IsInRole("1") || User.IsInRole("2"))
                        {
                            <a href="/Admin/Dashboard" class="customer-icon-btn customer-icon-btn-outline" title="Yönetim Paneli" aria-label="Yönetim Paneli">
                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg>
                            </a>
                        }
                        <a href="/Account/Logout" class="customer-icon-btn customer-icon-btn-logout" title="Çıkış" aria-label="Çıkış">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
                        </a>
                    }
                    else
                    {
                        <a href="/Account/Login" class="btn btn-outline-dark btn-sm rounded-pill px-2 px-lg-3 fw-medium customer-login-btn">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"></path><polyline points="10 17 15 12 10 7"></polyline><line x1="15" y1="12" x2="3" y2="12"></line></svg>
                            <span class="d-none d-lg-inline">Giriş Yap</span>
                        </a>
                    }
                </div>
                </div>
            </div>
        </nav>
    </header>
    <div class="container-fluid customer-page-shell">
        <main role="main" class="customer-main">
            @RenderBody()
        </main>
    </div>

    <!-- Offcanvas -->
    <div class="offcanvas offcanvas-end" tabindex="-1" id="catalogOffcanvas">
        <div class="offcanvas-header">
            <h5 class="offcanvas-title notranslate" translate="no" id="catalogPanelTitle">My Cart</h5>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button>
        </div>
        <div class="offcanvas-body d-flex flex-column">
            <div id="catalogItemsOffcanvas" class="flex-grow-1 overflow-auto mb-3"></div>
            <div class="d-flex gap-2 mt-auto">
                <button class="btn btn-outline-danger w-50" id="clearCatalogBtn">Temizle</button>
                <button type="button" class="btn btn-success w-50" id="openCustomerModalBtn">Onayla</button>
            </div>
        </div>
    </div>

    <!-- Modal -->
    <div class="modal fade" id="customerModal" tabindex="-1">
        <div class="modal-dialog">
            <form class="modal-content" id="customerOrderForm">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title">Müşteri Bilgileri</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p class="text-muted small mb-3">Bu bilgiler zorunludur. Başka biri adına sipariş veriyorsanız o kişinin bilgilerini yazın.</p>
                    <div class="mb-3">
                        <label for="companyName">Firma Adı <span class="text-danger">*</span></label>
                        <input type="text" id="companyName" name="companyName" class="form-control" required maxlength="200" autocomplete="organization" />
                    </div>
                    <div class="mb-3">
                        <label for="firstName">Ad <span class="text-danger">*</span></label>
                        <input type="text" id="firstName" name="firstName" class="form-control" required maxlength="100" autocomplete="given-name" />
                    </div>
                    <div class="mb-3">
                        <label for="lastName">Soyad <span class="text-danger">*</span></label>
                        <input type="text" id="lastName" name="lastName" class="form-control" required maxlength="100" autocomplete="family-name" />
                    </div>
                    <div class="mb-3">
                        <label for="phoneNumber">Telefon Numarası <span class="text-danger">*</span></label>
                        <input type="tel" id="phoneNumber" minlength="7" name="phoneNumber" class="form-control" required maxlength="40" autocomplete="tel" />
                    </div>
                </div>
                <div id="orderFormError" class="text-danger px-3" role="alert"></div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-primary w-100 notranslate" translate="no" id="completePdfBtn">Confirm and PDF</button>
                </div>
            </form>
        </div>
    </div>

    <div class="modal fade" id="orderSuccessModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered"><div class="modal-content">
            <div class="modal-header"><h5 class="modal-title">Sipariş alındı</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
            <div class="modal-body">
                <p id="orderSuccessText" role="status"></p>
                <div class="d-flex flex-wrap gap-2">
                    <a id="orderSuccessPdf" class="btn btn-outline-dark" href="#">PDF'yi tekrar indir</a>
                    <a class="btn btn-dark" href="/Orders/Mine">Siparişlerim</a>
                </div>
            </div>
        </div></div>
    </div>

    <div class="modal fade notranslate" id="b2bPasswordModal" tabindex="-1" aria-hidden="true" translate="no">
        <div class="modal-dialog modal-dialog-centered modal-sm"><div class="modal-content border-0 shadow-lg">
            <form id="b2bPasswordForm" class="notranslate" translate="no">@Html.AntiForgeryToken()
                <div class="modal-header"><h5 class="modal-title"><i class="fas fa-lock me-2"></i><span id="b2bPasswordTitle">B2B Fiyatlarına Dön</span></h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
                <div class="modal-body"><label class="form-label" id="b2bPasswordLabel">Giriş Şifreniz</label><input type="password" id="b2bPassword" class="form-control" autocomplete="current-password" required /><div id="b2bPasswordError" class="text-danger small mt-2 d-none"></div></div>
                <div class="modal-footer border-0"><button type="button" class="btn btn-light" data-bs-dismiss="modal" id="b2bPasswordCancel">Vazgeç</button><button type="submit" class="btn btn-dark" id="b2bPasswordSubmit">Doğrula</button></div>
            </form>
        </div></div>
    </div>

    <footer class="customer-footer text-muted">
        <div class="container">
            &copy; 2026 - Naif Jewellery
        </div>
    </footer>

    <!-- Loading Overlay -->
    <div id="loadingOverlay" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.85); z-index: 9999; flex-direction:column; align-items:center; justify-content:center; color:white;">
        <div class="spinner-border text-light mb-3" style="width: 4rem; height: 4rem;" role="status"></div>
        <h4 id="loadingText" class="mb-4">PDF Oluşturuluyor, Lütfen Bekleyiniz...</h4>
        <p class="text-muted mb-4">(Resimlerin çözünürlüğü yüksekse işlem birkaç dakika sürebilir)</p>
        <button class="btn btn-danger px-5" id="cancelPdfBtn">İptal Et</button>
    </div>

    <!-- Image Lightbox Modal -->
    <div class="modal fade" id="imageLightbox" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-xl">
            <div class="modal-content bg-transparent border-0 shadow-none">
                <div class="modal-body p-0 text-center">
                    <div class="d-inline-block position-relative">
                        <img id="lightboxImage" src="" alt="Ürün" class="img-fluid rounded" style="max-height: 85vh; object-fit: contain; background: #fff; box-shadow: 0 8px 40px rgba(0,0,0,0.5);" />
                        <button type="button" class="position-absolute border-0" data-bs-dismiss="modal" aria-label="Kapat" style="top: 8px; right: 8px; z-index:10; width: 32px; height: 32px; border-radius: 50%; background: rgba(0,0,0,0.6); color: #fff; font-size: 18px; line-height: 32px; text-align: center; cursor: pointer;">&times;</button>
                        <button type="button" id="lightboxAddCart" class="btn btn-dark btn-sm position-absolute rounded-pill px-3 py-1" style="bottom: 12px; right: 12px; z-index:10; border: 1px solid #aaa; font-size: 13px; opacity: 0.9;">Kataloğa Ekle</button>
                        <button type="button" id="lightboxPrev" class="position-absolute border-0" style="top: 50%; left: 8px; transform: translateY(-50%); z-index:10; width: 36px; height: 36px; border-radius: 50%; background: rgba(0,0,0,0.5); color: #fff; font-size: 20px; line-height: 36px; text-align: center; cursor: pointer;">&#10094;</button>
                        <button type="button" id="lightboxNext" class="position-absolute border-0" style="top: 50%; right: 8px; transform: translateY(-50%); z-index:10; width: 36px; height: 36px; border-radius: 50%; background: rgba(0,0,0,0.5); color: #fff; font-size: 20px; line-height: 36px; text-align: center; cursor: pointer;">&#10095;</button>

                        <span id="lightboxCounter" class="position-absolute" style="bottom: 14px; left: 50%; transform: translateX(-50%); z-index:10; background: rgba(0,0,0,0.5); color: #fff; font-size: 13px; padding: 3px 12px; border-radius: 12px;"></span>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Global Error Modal -->
    <div class="modal fade" id="globalErrorModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-sm">
            <div class="modal-content border-0 shadow">
                <div class="modal-body text-center p-4">
                    <i class="fas fa-exclamation-circle text-danger mb-3" style="font-size: 3rem;"></i>
                    <h5 class="mb-3" id="globalErrorTitle">Hata</h5>
                    <p class="text-muted mb-4" id="globalErrorMessage">Bir sorun oluştu.</p>
                    <button type="button" class="btn btn-dark w-100 rounded-pill" data-bs-dismiss="modal">Tamam</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Confirm Clear Catalog Modal -->
    <div class="modal fade" id="confirmClearModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-sm">
            <div class="modal-content border-0 shadow">
                <div class="modal-body text-center p-4">
                    <i class="fas fa-trash-alt text-danger mb-3" style="font-size: 3rem;"></i>
                    <h5 class="mb-3">Emin misiniz?</h5>
                    <p class="text-muted mb-4">Kataloğunuz tamamen sıfırlanacak ve eklediğiniz tüm ürünler silinecek.</p>
                    <div class="d-flex gap-2 justify-content-center">
                        <button type="button" class="btn btn-light rounded-pill w-50" data-bs-dismiss="modal">İptal</button>
                        <button type="button" class="btn btn-danger rounded-pill w-50" id="confirmClearCatalogActionBtn">Evet, Temizle</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        function readMultiplier(value, minimum) {
            const parsed = parseFloat(String(value ?? '').replace(',', '.'));
            return Number.isFinite(parsed) && parsed >= minimum ? parsed : minimum;
        }
        const pricingButton = document.getElementById('b2cButton');
        window.naifPricingMode = sessionStorage.getItem('naif_pricing_mode') || 'b2b';
        window.naifB2CMultiplier = readMultiplier(pricingButton?.dataset.multiplier, 1);
        window.applyPricingMode = function(basePrice) {
            const b2bPrice = Number(basePrice) || 0;
            return window.naifPricingMode === 'b2c' ? b2bPrice * window.naifB2CMultiplier : b2bPrice;
        };
        function refreshPricingModeUI() {
            const isB2C = window.naifPricingMode === 'b2c';
            const modeLabel = document.getElementById('pricingModeButtonText');
            if (modeLabel) modeLabel.textContent = isB2C ? 'B2B' : 'B2C';
            document.querySelectorAll('[data-b2b-price]').forEach(el => {
                const price = window.applyPricingMode(parseFloat(el.dataset.b2bPrice) || 0);
                el.textContent = price.toLocaleString('en-US', { maximumFractionDigits: 0 }) + ' $';
            });
            if (typeof recalculatePrice === 'function') recalculatePrice();
        }
        document.getElementById('b2cButton')?.addEventListener('click', function() {
            if (window.naifPricingMode === 'b2b') {
                window.naifPricingMode = 'b2c';
                sessionStorage.setItem('naif_pricing_mode', 'b2c');
                refreshPricingModeUI();
            } else {
                document.getElementById('b2bPasswordError')?.classList.add('d-none');
                bootstrap.Modal.getOrCreateInstance(document.getElementById('b2bPasswordModal')).show();
            }
        });
        document.addEventListener('submit', async function(e) {
            const form = e.target;
            if (!form || form.id !== 'b2bPasswordForm') return;
            e.preventDefault();
            const error = document.getElementById('b2bPasswordError');
            const submitButton = document.getElementById('b2bPasswordSubmit');
            const password = form.querySelector('#b2bPassword')?.value || '';
            const token = form.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
            if (submitButton) submitButton.disabled = true;
            try {
                const response = await fetch('/Account/VerifyCurrentPassword', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
                    body: JSON.stringify({ password: password })
                });
                let result = {};
                try { result = await response.json(); } catch (_) {}
                if (!response.ok || !result.isSuccess) {
                    if (error) {
                        error.textContent = result.message || 'Şifre hatalı.';
                        error.classList.remove('d-none');
                    }
                    return;
                }
                window.naifPricingMode = 'b2b';
                sessionStorage.setItem('naif_pricing_mode', 'b2b');
                refreshPricingModeUI();
                form.reset();
                bootstrap.Modal.getOrCreateInstance(document.getElementById('b2bPasswordModal')).hide();
            } catch (_) {
                if (error) {
                    error.textContent = 'Doğrulama tamamlanamadı. Lütfen tekrar deneyin.';
                    error.classList.remove('d-none');
                }
            } finally {
                if (submitButton) submitButton.disabled = false;
            }
        });
        document.addEventListener('DOMContentLoaded', refreshPricingModeUI);
    </script>
    @await RenderSectionAsync("Scripts", required: false)

    <!-- Google Translate Setup -->
    <div id="google_translate_element" style="display:none;"></div>
    <script type="text/javascript">
        function naifSavedLanguage() {
            try {
                var lang = localStorage.getItem('naif_language');
                return lang === 'tr' || lang === 'en' ? lang : 'en';
            } catch (e) {
                return 'en';
            }
        }

        function naifWriteGoogTransCookie(value, expires) {
            var hostname = location.hostname;
            var domains = [''];
            if (hostname && hostname !== 'localhost' && hostname !== '127.0.0.1') {
                domains.push(hostname, '.' + hostname);
            }
            domains.forEach(function(domain) {
                document.cookie = 'googtrans=' + value + ';path=/;' + expires + (domain ? ';domain=' + domain : '');
            });
        }

        function naifSyncTranslateCookie(lang) {
            if (lang === 'en') {
                naifWriteGoogTransCookie('/tr/en', 'expires=Thu, 01 Jan 2099 00:00:00 GMT');
            } else {
                naifWriteGoogTransCookie('', 'expires=Thu, 01 Jan 1970 00:00:00 GMT');
            }
        }

        naifSyncTranslateCookie(naifSavedLanguage());

        function googleTranslateElementInit() {
            new google.translate.TranslateElement({pageLanguage: 'tr', includedLanguages: 'tr,en', autoDisplay: false}, 'google_translate_element');
            applySavedLanguage();
        }

        function applySavedLanguage() {
            var lang = naifSavedLanguage();
            var attempts = 0;
            var timer = setInterval(function() {
                attempts++;
                var selectField = document.querySelector('.goog-te-combo');
                var ready = selectField && (lang === 'tr' || Array.from(selectField.options).some(function(option) { return option.value === lang; }));
                if (ready) {
                    clearInterval(timer);
                    changeLanguage(lang);
                } else if (attempts >= 20) {
                    clearInterval(timer);
                    updateLanguageChrome(lang);
                }
            }, 150);
        }

        function updateLanguageChrome(lang) {
            var isEnglish = lang === 'en';
            var flag = document.getElementById('currentLangFlag');
            var text = document.getElementById('currentLangText');
            var cartButton = document.getElementById('catalogButtonText');
            var cartTitle = document.getElementById('catalogPanelTitle');
            if (flag) flag.src = isEnglish ? 'https://flagcdn.com/w20/us.png' : 'https://flagcdn.com/w20/tr.png';
            if (flag) flag.alt = isEnglish ? 'EN' : 'TR';
            if (text) text.innerText = isEnglish ? 'EN' : 'TR';
            if (cartButton) cartButton.innerText = isEnglish ? 'My Cart' : 'Sepetim';
            if (cartTitle) cartTitle.innerText = isEnglish ? 'My Cart' : 'Sepetim';
            document.querySelectorAll('[data-cart-button-text]').forEach(function(el) {
                el.textContent = isEnglish ? 'Add to cart' : 'Sepete Ekle';
            });
            var passwordTitle = document.getElementById('b2bPasswordTitle');
            var passwordLabel = document.getElementById('b2bPasswordLabel');
            var passwordCancel = document.getElementById('b2bPasswordCancel');
            var passwordSubmit = document.getElementById('b2bPasswordSubmit');
            if (passwordTitle) passwordTitle.textContent = isEnglish ? 'Return to B2B Pricing' : 'B2B Fiyatlarına Dön';
            if (passwordLabel) passwordLabel.textContent = isEnglish ? 'Your login password' : 'Giriş Şifreniz';
            if (passwordCancel) passwordCancel.textContent = isEnglish ? 'Cancel' : 'Vazgeç';
            if (passwordSubmit) passwordSubmit.textContent = isEnglish ? 'Verify' : 'Doğrula';
        }
        
        function changeLanguage(lang) {
            if (lang !== 'tr' && lang !== 'en') lang = 'en';
            try { localStorage.setItem('naif_language', lang); } catch (e) {}
            naifSyncTranslateCookie(lang);

            var selectField = document.querySelector(".goog-te-combo");
            if (selectField) {
                var hasOption = Array.from(selectField.options).some(function(option) { return option.value === lang; });
                var target = hasOption ? lang : (lang === 'tr' ? '' : lang);
                if (selectField.value !== target) {
                    selectField.value = target;
                    selectField.dispatchEvent(new Event('change'));
                }
            }

            updateLanguageChrome(lang);
        }
    </script>
    <script type="text/javascript" src="//translate.google.com/translate_a/element.js?cb=googleTranslateElementInit"></script>
    
