                Toast.fire({ icon: 'success', title: 'İşlem Başarılı' }).then(() => { location.reload(); });
            } else { showInfoModal('Hata', 'İşlem başarısız oldu.'); }
        } catch (err) { showInfoModal('İşlem Başarısız', err.message); }
