@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var productCount = (int)(ViewBag.ProductCount ?? 0);
    var userCount = (int)(ViewBag.UserCount ?? 0);
    var categoryCount = (int)(ViewBag.CategoryCount ?? 0);
    var alertCount = (int)(ViewBag.AlertCount ?? 0);
    var alertSummaries = ViewBag.AlertSummaries as List<string> ?? new List<string>();
    var recentProducts = ViewBag.RecentProducts as List<naif_katalog.Models.Product> ?? new List<naif_katalog.Models.Product>();
}

<style>
    .content-body:has(.dashboard-page) {
        display: flex;
        flex-direction: column;
        min-height: 0;
        overflow: hidden;
    }
    .dashboard-page {
        flex: 1;
        min-height: 0;
        display: flex;
        flex-direction: column;
    }
    .dashboard-grid {
        display: grid !important;
        grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
        gap: 16px;
        margin-bottom: 16px;
        flex-shrink: 0;
    }
    .dashboard-grid .card {
        margin-bottom: 0;
        min-width: 0;
        text-decoration: none;
        color: inherit;
        display: block;
    }
    .dashboard-stat-label {
        color: var(--text-muted);
        font-size: 14px;
        margin-bottom: 8px;
        font-weight: 500;
    }
    .dashboard-stat-value {
        font-size: 28px;
        font-weight: 700;
        line-height: 1.1;
    }
    .dashboard-stat-hint {
        margin-top: 8px;
        color: var(--text-muted);
        font-size: 12px;
        line-height: 1.4;
    }
    .dashboard-recent {
        flex: 1;
        min-height: 0;
        margin-bottom: 0 !important;
        display: flex;
        flex-direction: column;
    }
    .dashboard-recent-header {
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 12px;
    }
    .dashboard-recent-header h3 { margin: 0; font-size: 18px; }
    .dashboard-recent-actions { display: flex; align-items: center; gap: 8px; flex-shrink: 0; }
    .dashboard-recent-header a { color: var(--primary); font-size: 13px; font-weight: 600; text-decoration: none; white-space: nowrap; }
    .recent-nav {
        width: 34px; height: 34px; border: 1px solid #e2e8f0; border-radius: 50%;
        background: #fff; color: #1f2937; display: inline-flex; align-items: center; justify-content: center;
    }
    .recent-slider {
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        background: #fff;
        overflow: hidden;
        position: relative;
        flex: 1;
        min-height: 0;
        display: flex;
        flex-direction: column;
    }
    .recent-track {
        flex: 1;
        min-height: 0;
        overflow-y: auto;
        overflow-x: hidden;
        scroll-snap-type: y mandatory;
        scroll-behavior: smooth;
        -webkit-overflow-scrolling: touch;
        scrollbar-width: thin;
        scrollbar-color: #cbd5e1 transparent;
    }
    .recent-table {
        width: 100%;
        min-width: 0 !important;
        border-collapse: collapse;
        text-align: left;
    }
    .recent-table th {
        position: sticky; top: 0; z-index: 1;
        padding: 10px 12px;
        color: var(--text-muted);
        font-size: 12px;
        font-weight: 600;
        background: #f8fafc;
        border-bottom: 1px solid #e5e7eb;
    }
    .recent-table td {
        padding: 11px 12px;
        border-bottom: 1px solid #eef2f6;
        font-size: 13px;
        background: #fff;
    }
    .recent-table tbody tr { scroll-snap-align: start; }
    .recent-table tbody tr:last-child td { border-bottom: 0; }
    .recent-code { font-weight: 600; }
    .recent-status {
        background: #d1fae5;
        color: #065f46;
        padding: 4px 8px;
        border-radius: 4px;
        font-size: 12px;
        font-weight: 600;
        white-space: nowrap;
    }
    .dashboard-empty { color: var(--text-muted); text-align: center; padding: 28px 8px; }
    @@media (max-width: 767.98px) {
        .dashboard-grid { gap: 10px; }
        .dashboard-stat-value { font-size: 22px; }
        .dashboard-stat-label { font-size: 13px; }
        .dashboard-stat-hint { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .dashboard-recent-header h3 { font-size: 16px; }
        .recent-table th, .recent-table td { padding: 10px 8px; font-size: 12px; }
    }
</style>

<div class="dashboard-page">
<div class="dashboard-grid" style="display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px;margin-bottom:16px;">
    <a class="card" href="/Product/Index" style="border-left:4px solid var(--primary);">
        <div class="dashboard-stat-label">Toplam Ürün</div>
        <div class="dashboard-stat-value">@productCount.ToString("N0")</div>
        <div class="dashboard-stat-hint">Katalogdaki tüm ürünler</div>
    </a>
    <a class="card" href="/Admin/Customers" style="border-left:4px solid #10b981;">
        <div class="dashboard-stat-label">Kayıtlı Müşteri</div>
        <div class="dashboard-stat-value">@userCount.ToString("N0")</div>
        <div class="dashboard-stat-hint">Aktif B2B hesapları</div>
    </a>
    <a class="card" href="/Category/Index" style="border-left:4px solid #f59e0b;">
        <div class="dashboard-stat-label">Kategoriler</div>
        <div class="dashboard-stat-value">@categoryCount.ToString("N0")</div>
        <div class="dashboard-stat-hint">Tanımlı kategori sayısı</div>
    </a>
    <a class="card" href="/Admin/Customers" style="border-left:4px solid @(alertCount > 0 ? "#ef4444" : "#8b5cf6");">
        <div class="dashboard-stat-label">Sistem Uyarıları</div>
        <div class="dashboard-stat-value">@alertCount.ToString("N0")</div>
        <div class="dashboard-stat-hint">@(alertSummaries.Count > 0 ? string.Join(" · ", alertSummaries) : "Kilit veya süre uyarısı yok")</div>
    </a>
</div>

<div class="card dashboard-recent">
    <div class="dashboard-recent-header">
        <h3>Son Eklenen Ürünler</h3>
        <div class="dashboard-recent-actions">
            @if (recentProducts.Count > 0)
            {
                <button type="button" class="recent-nav" data-recent-dir="-1" aria-label="Yukarı"><i class="fas fa-chevron-up"></i></button>
                <button type="button" class="recent-nav" data-recent-dir="1" aria-label="Aşağı"><i class="fas fa-chevron-down"></i></button>
            }
            <a href="/Product/Index">Tümünü gör</a>
        </div>
    </div>
    @if (recentProducts.Count == 0)
    {
        <div class="dashboard-empty">Henüz ürün bulunamadı.</div>
    }
    else
    {
        <div class="recent-slider">
            <div class="recent-track" id="recentProductsTrack">
                <table class="recent-table">
                    <thead>
                        <tr>
                            <th>Kod</th>
                            <th>Kategori</th>
                            <th>Ayar</th>
                            <th>Durum</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in recentProducts)
                        {
                            <tr>
                                <td class="recent-code">@item.Code</td>
                                <td>@(item.CategoryNames != null && item.CategoryNames.Count > 0 ? string.Join(", ", item.CategoryNames) : "-")</td>
                                <td>@(string.IsNullOrWhiteSpace(item.MetalPurityName) ? "-" : item.MetalPurityName)</td>
                                <td><span class="recent-status">Aktif</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
</div>
<script>
    (() => {
        const track = document.getElementById('recentProductsTrack');
        if (!track) return;
        const scrollByRow = dir => {
            const row = track.querySelector('.recent-table tbody tr');
            const amount = row ? row.getBoundingClientRect().height : 48;
            track.scrollBy({ top: dir * amount * 4, behavior: 'smooth' });
        };
        document.querySelectorAll('[data-recent-dir]').forEach(btn => {
            btn.addEventListener('click', () => scrollByRow(Number(btn.dataset.recentDir)));
        });
    })();
</script>
